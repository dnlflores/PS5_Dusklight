+
+ProcessScope::ProcessScope(const base_process_class* proc)
+    : mSaved(g_ctx), mSavedOwner(s_curOwner), mChanged(false) {
+    if (s_owned.empty() && s_lead == 0 && s_scopeDepth == 0) {
+        return;  // one player: nothing to switch
+    }
+    mChanged = true;
+    s_scopeDepth++;
+    if (proc == nullptr) {
+        return;
+    }
+    // A player's process runs as that player, anything else as the lead.
+    // Draws use the camera of the half being drawn, except a camera's own
+    // draw, which always sees itself as camera 0 of its player.
+    const int owner = ownerOf(proc);
+    s_curOwner = owner;
+    const uint8_t player = owner >= 0 ? static_cast<uint8_t>(owner) : s_lead;
+    Ctx to;
+    to.player = player;
+    to.camera = (s_inDraw && !isCameraProc(proc)) ? passCamera() : player;
+    if (to.player != g_ctx.player || to.camera != g_ctx.camera) {
+        switchTo(to);
+    }
+}
+
+ProcessScope::~ProcessScope() {
+    if (mChanged) {
+        leaveScope(mSaved, mSavedOwner);
+    }
+}
+
+ScopedCtx::ScopedCtx(uint8_t player, uint8_t camera) : mSaved(g_ctx), mSavedOwner(s_curOwner), mChanged(true) {
+    s_scopeDepth++;
+    s_curOwner = player;
+    const Ctx to = {player, camera};
+    if (to.player != g_ctx.player || to.camera != g_ctx.camera) {
+        switchTo(to);
+    }
+}
+
+ScopedCtx::~ScopedCtx() {
+    leaveScope(mSaved, mSavedOwner);
+}
