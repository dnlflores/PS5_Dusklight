@@ -0,0 +1,827 @@
+// Split-screen co-op: Player 2's processes, context and companion rules.
+// See splitscreen.h and docs/splitscreen.md.
+
+#include "dusk/splitscreen.h"
+#include "dusk/splitscreen_colors.h"
+
+#include "JSystem/J3DGraphBase/J3DSys.h"
+#include "JSystem/JKernel/JKRHeap.h"
+#include "SSystem/SComponent/c_malloc.h"
+#include "d/actor/d_a_alink.h"
+#include "d/actor/d_a_horse.h"
+#include "d/actor/d_a_player.h"
+#include "d/d_attention.h"
+#include "d/d_bg_s_gnd_chk.h"
+#include "d/d_camera.h"
+#include "d/d_com_inf_game.h"
+#include "dusk/logging.h"
+#include "dusk/settings.h"
+#include "f_op/f_op_actor_mng.h"
+#include "f_op/f_op_camera_mng.h"
+#include "f_pc/f_pc_manager.h"
+#include "f_pc/f_pc_name.h"
+#include "m_Do/m_Do_controller_pad.h"
+#include "m_Do/m_Do_ext.h"
+#include "m_Do/m_Do_graphic.h"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <unordered_set>
+#include <vector>
+
+namespace dusk::splitscreen {
+
+Ctx g_ctx = {0, 0};
+
+namespace {
+
+// Player 2 is brought back next to Player 1 past these distances, or after
+// this long in another room. On horseback the players are allowed further apart.
+constexpr f32 kLeashDistance = 1800.0f;
+constexpr f32 kHardLeashDistance = 4000.0f;
+constexpr f32 kRidingLeashDistance = 6000.0f;
+constexpr f32 kRidingHardLeashDistance = 9000.0f;
+constexpr int kSeparatedFramesLimit = 45;
+constexpr int kPruneInterval = 60;
+
+constexpr fpc_ProcID kNoProc = fpcM_ERROR_PROCESS_ID_e;
+
+std::unordered_set<fpc_ProcID> s_owned;
+// Player 2's processes that were told to go and have not been deleted yet. A
+// process leaves the executor (fpcM_SearchByID stops finding it) as soon as
+// it is queued for deletion, but its delete method runs later; the next
+// Player 2 is not created until the last one is really gone.
+std::unordered_set<fpc_ProcID> s_pendingDelete;
+int s_pendingDeleteFrames = 0;
+constexpr int kPendingDeleteGiveUpFrames = 300;
+fpc_ProcID s_p2LinkId = kNoProc;
+fpc_ProcID s_p2CameraId = kNoProc;
+fpc_ProcID s_p2HorseId = kNoProc;
+
+// The lead is the player the world follows: whose Link the NPCs, events,
+// doors, rooms and menus see as "the player", and whose camera shows the
+// cutscenes. It is whoever last talked to someone, opened a door or a chest,
+// got an item or paused (Player 1 when a scene starts). Each player's own
+// processes (their Link, camera, horse, and what those spawn) always run as
+// that player. Processes owned by Player 1: s_ownedP1; by Player 2: s_owned.
+uint8_t s_lead = 0;
+std::unordered_set<fpc_ProcID> s_ownedP1;
+// Context scopes in progress, and the owner (0, 1, or -1 for the world) of
+// the process running now; what a process creates belongs to its owner.
+int s_scopeDepth = 0;
+int s_curOwner = -1;
+bool s_inPass = false;
+bool s_bringPlayer1Requested = false;
+// Whether Player 2's camera is up, worked out once a frame: active() is asked
+// for every process drawn, and looking a process up walks the process list.
+bool s_p2CameraReady = false;
+
+bool s_sceneActive = false;
+bool s_spawnedThisScene = false;
+bool s_inDraw = false;
+uint8_t s_passCamera = 0;  // physical camera of the half being drawn
+bool s_extraPass = false;
+bool s_suspended = false;
+bool s_respawnRequested = false;
+int s_cooldown = 0;
+int s_separatedFrames = 0;
+int s_pruneTimer = 0;
+
+void* s_p2AttentionMem = nullptr;
+dAttention_c* s_p2Attention = nullptr;
+
+// Parts of the per-frame item/HUD state that belong to whichever Link is
+// running: the button prompts it sets and its oxygen. The live copy is the
+// running player's; the bank holds the other player's. (Player 2's damage is
+// dropped where it is taken, see dropsDamage(), so it does not empty the
+// shared hearts; it still knocks Player 2 back.)
+struct Bank {
+    int oxygen[5] = {};
+    std::array<u8, 128> status = {};
+};
+Bank s_bank;
+
+u8* statusBegin(dComIfG_item_info_class& info) { return &info.mRStatus; }
+size_t statusSize(dComIfG_item_info_class& info) {
+    return static_cast<size_t>(&info.mSelectItem[0] - &info.mRStatus);
+}
+
+void swapBank() {
+    dComIfG_item_info_class& info = g_dComIfG_gameInfo.play.mItemInfo;
+    std::swap(info.mOxygen, s_bank.oxygen[0]);
+    std::swap(info.mNowOxygen, s_bank.oxygen[1]);
+    std::swap(info.mMaxOxygen, s_bank.oxygen[2]);
+    std::swap(info.mOxygenCount, s_bank.oxygen[3]);
+    std::swap(info.mMaxOxygenCount, s_bank.oxygen[4]);
+    const size_t n = statusSize(info);
+    u8* live = statusBegin(info);
+    for (size_t i = 0; i < n; i++) {
+        std::swap(live[i], s_bank.status[i]);
+    }
+}
+
+void initBankFromLive() {
+    dComIfG_item_info_class& info = g_dComIfG_gameInfo.play.mItemInfo;
+    s_bank.oxygen[0] = info.mOxygen;
+    s_bank.oxygen[1] = info.mMaxOxygen;
+    s_bank.oxygen[2] = info.mMaxOxygen;
+    s_bank.oxygen[3] = 0;
+    s_bank.oxygen[4] = info.mMaxOxygenCount;
+    s_bank.status.fill(0);
+}
+
+void switchTo(Ctx to) {
+    if (to.player != g_ctx.player) {
+        swapBank();
+    }
+    g_ctx = to;
+}
+
+int ownerOf(const base_process_class* proc) {
+    if (proc == nullptr) {
+        return -1;
+    }
+    if (!s_owned.empty() && s_owned.count(proc->id) != 0) {
+        return 1;
+    }
+    // Midna goes with the lead, like the rest of the world.
+    if (s_ownedP1.count(proc->id) != 0 && proc->name != fpcNm_MIDNA_e) {
+        return 0;
+    }
+    return -1;
+}
+
+int windowCountNow();
+void setLead(uint8_t lead, const char* why);
+
+// The camera the scene is being drawn for: the half's, while the second half
+// is drawn; otherwise the first half's (Player 1's), or the lead's when the
+// screen is not split.
+uint8_t passCamera() {
+    if (s_inPass) {
+        return s_passCamera;
+    }
+    return windowCountNow() > 1 ? 0 : s_lead;
+}
+
+// The context outside any process: the lead's.
+Ctx topCtx() {
+    return {s_lead, s_inPass ? s_passCamera : s_lead};
+}
+
+void leaveScope(Ctx saved, int savedOwner) {
+    s_scopeDepth--;
+    s_curOwner = savedOwner;
+    // The outermost scope goes back to the lead's context, which may have
+    // changed while it ran.
+    const Ctx to = s_scopeDepth == 0 ? topCtx() : saved;
+    if (to.player != g_ctx.player || to.camera != g_ctx.camera) {
+        switchTo(to);
+    }
+}
+
+bool isCameraProc(const base_process_class* proc) {
+    return proc->profname == fpcNm_CAMERA_e || proc->name == fpcNm_CAMERA_e;
+}
+
+bool procAlive(fpc_ProcID id) {
+    return id != kNoProc && (fpcM_SearchByID(id) != NULL || fpcM_IsCreating(id));
+}
+
+bool procCreated(fpc_ProcID id) {
+    return id != kNoProc && fpcM_SearchByID(id) != NULL && !fpcM_IsCreating(id);
+}
+
+dComIfG_play_c& play() { return g_dComIfG_gameInfo.play; }
+
+void createAttention() {
+    if (s_p2Attention != nullptr) {
+        return;
+    }
+    s_p2AttentionMem = JKRHeap::alloc(sizeof(dAttention_c), 4, (JKRHeap*)mDoExt_getGameHeap());
+    if (s_p2AttentionMem == nullptr) {
+        DuskLog.warn("splitscreen: no memory for Player 2's attention");
+        return;
+    }
+    // Player 2's camera calls Init() with Player 2 once it has one.
+    s_p2Attention = JKR_NEW_ARGS(s_p2AttentionMem) dAttention_c(NULL, PAD_1);
+    play().mPlayer2Attention = s_p2Attention;
+}
+
+void destroyAttention() {
+    play().mPlayer2Attention = nullptr;
+    if (s_p2Attention != nullptr) {
+        s_p2Attention->~dAttention_c();
+        s_p2Attention = nullptr;
+    }
+    if (s_p2AttentionMem != nullptr) {
+        JKRHeap::free(s_p2AttentionMem, NULL);
+        s_p2AttentionMem = nullptr;
+    }
+}
+
+void setupTables() {
+    // Window 1 is drawn full size, like window 0, with a camera of half the
+    // aspect ratio; the painter then puts each one in its half of the screen.
+    dComIfGp_setWindow(1, 0.0f, 0.0f, FB_WIDTH, FB_HEIGHT, 0.0f, 1.0f, 1, 2);
+    play().setCameraInfoPhysical(1, NULL, 1, 1, -1);
+    play().setPlayerInfoPhysical(1, NULL, 1);
+    // The stage's camera settings archive is per stage, not per camera.
+    play().mCameraInfo[1].mCameraParamFileName = play().mCameraInfo[0].mCameraParamFileName;
+    play().mCameraInfo[1].mCameraZoomScale = play().mCameraInfo[0].mCameraZoomScale;
+    play().mCameraInfo[1].mCameraZoomForcus = play().mCameraInfo[0].mCameraZoomForcus;
+}
+
+cXyz spawnPosition(fopAc_ac_c* next) {
+    // Behind the Link joined, or beside them, clear of the horse, when they ride.
+    const bool riding = static_cast<daPy_py_c*>(next)->checkRide();
+    const s16 back = next->shape_angle.y + (riding ? 0x4000 : 0x8000);
+    const f32 offset = riding ? 220.0f : 90.0f;
+    cXyz pos(next->current.pos.x + cM_ssin(back) * offset, next->current.pos.y + 30.0f,
+             next->current.pos.z + cM_scos(back) * offset);
+
+    dBgS_GndChk gnd;
+    gnd.SetPos(&pos);
+    const f32 y = dComIfG_Bgsp().GroundCross(&gnd);
+    if (y == -G_CM3D_F_INF || std::fabs(y - next->current.pos.y) > 60.0f) {
+        return next->current.pos;
+    }
+    pos.y = y;
+    return pos;
+}
+
+void spawn(fopAc_ac_c* p1) {
+    setupTables();
+    createAttention();
+    initBankFromLive();
+
+    const cXyz pos = spawnPosition(p1);
+    const csXyz angle(0, p1->shape_angle.y, 0);
+    const u32 params = static_cast<u32>(fopAcM_GetRoomNo(p1)) & 0x3F;
+
+    ScopedCtx ctx(1, 1);
+
+    auto* camPrm = static_cast<fopCamM_prm_class*>(cMl::memalignB(-4, sizeof(fopCamM_prm_class)));
+    if (camPrm == nullptr) {
+        DuskLog.warn("splitscreen: no memory for Player 2's camera");
+        return;
+    }
+    std::memset(camPrm, 0, sizeof(fopCamM_prm_class));
+    // Camera index 1. fopCam_Create reads this word as a host u32 (the field
+    // is declared big-endian, for stage data), so it is written raw.
+    const u32 cameraIndex = 1;
+    std::memcpy(camPrm, &cameraIndex, sizeof(cameraIndex));
+    s_p2CameraId = fopCamM_Create(1, fpcNm_CAMERA_e, camPrm);
+
+    // Room -1, as Player 1 is created: the actor is not deleted with a room.
+    s_p2LinkId = fopAcM_create(fpcNm_ALINK_e, params, &pos, -1, &angle, NULL, -1);
+
+    s_suspended = false;
+    s_respawnRequested = false;
+    s_separatedFrames = 0;
+    s_spawnedThisScene = true;
+    DuskLog.info("splitscreen: Player 2 joining (link {}, camera {})", s_p2LinkId, s_p2CameraId);
+}
+
+void despawn() {
+    // Everything of Player 2's goes: its Link, its camera, and what the Link
+    // had out (a bomb, an arrow), which would otherwise look for a Player 2
+    // that is not there.
+    const std::vector<fpc_ProcID> ids(s_owned.begin(), s_owned.end());
+    for (fpc_ProcID id : ids) {
+        if (procCreated(id) && fpcM_Delete(fpcM_SearchByID(id))) {
+            s_pendingDelete.insert(id);
+        }
+    }
+    s_pendingDeleteFrames = 0;
+
+    // Nothing may find the old Player 2 from here on: not the next Player 2's
+    // camera looking for its player, not the lock-on system.
+    play().setPlayerInfoPhysical(1, NULL, 1);
+    play().mPlayer2LinkPtr = NULL;
+    play().mPlayer2HorsePtr = NULL;
+    play().mCameraInfo[1].mCamera = NULL;
+
+    s_p2LinkId = kNoProc;
+    s_p2CameraId = kNoProc;
+    s_p2HorseId = kNoProc;
+    s_p2CameraReady = false;
+    s_suspended = false;
+    s_respawnRequested = false;
+    s_separatedFrames = 0;
+    setLead(0, "Player 2 leaves");
+}
+
+void prune() {
+    for (auto it = s_owned.begin(); it != s_owned.end();) {
+        if (!procAlive(*it) && s_pendingDelete.count(*it) == 0) {
+            it = s_owned.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    std::erase_if(s_ownedP1, [](fpc_ProcID id) { return !procAlive(id); });
+}
+
+void setLead(uint8_t lead, const char* why) {
+    if (lead == s_lead) {
+        return;
+    }
+    s_lead = lead;
+    DuskLog.info("splitscreen: Player {} leads ({})", lead + 1, why);
+    if (s_scopeDepth == 0) {
+        switchTo(topCtx());
+    }
+    // Otherwise the outermost scope switches as it ends.
+}
+
+// Player 1's Link and camera, and from them on what they create.
+void markPlayer1(fopAc_ac_c* p1) {
+    s_ownedP1.insert(fopAcM_GetID(p1));
+    if (camera_class* cam = play().getCameraPhysical(0)) {
+        s_ownedP1.insert(fpcM_GetID(cam));
+    }
+}
+
+// Player 1 cannot be created again (they are the Link the scene made), so
+// when Player 2 leads and they get separated, they are moved to Player 2.
+void bringPlayer1ToLead(fopAc_ac_c* p1, fopAc_ac_c* p2) {
+    const cXyz pos = spawnPosition(p2);
+    ScopedCtx ctx(0, 0);
+    static_cast<daPy_py_c*>(p1)->setPlayerPosAndAngle(&pos, p2->shape_angle.y, TRUE);
+    fopAcM_SetRoomNo(p1, fopAcM_GetRoomNo(p2));
+    if (auto* cam = reinterpret_cast<camera_process_class*>(play().getCameraPhysical(0))) {
+        const s16 back = p2->shape_angle.y + 0x8000;
+        const cXyz center(pos.x, pos.y + 130.0f, pos.z);
+        const cXyz eye(pos.x + cM_ssin(back) * 350.0f, pos.y + 220.0f, pos.z + cM_scos(back) * 350.0f);
+        cam->mCamera.Reset(center, eye);
+    }
+}
+
+bool worldBusy() {
+    // Paused covers the item and collection menus, whose Link doll uses the
+    // model data the two Links share.
+    return dComIfGp_event_runCheck() || dComIfGp_isEnableNextStage() || dComIfGp_isPauseFlag();
+}
+
+// Player 2's own horse, beside Player 1's, whenever Player 1's is out (not
+// waiting off-screen to be called). It is Player 2's like their Link: it runs in
+// their context, so the horse lookups in it, in their Link and in their camera
+// find it, and it goes with them.
+void updatePlayer2Horse() {
+    auto* p1Horse = static_cast<daHorse_c*>(play().getHorsePhysical(0));
+    const bool p1HorseOut = p1Horse != nullptr && !fpcM_IsCreating(fopAcM_GetID(p1Horse)) &&
+                            !p1Horse->checkStateFlg0(daHorse_c::FLG0_NO_DRAW_WAIT);
+    const bool have = procAlive(s_p2HorseId);
+    auto* p2 = static_cast<daPy_py_c*>(player2());
+    if (!p1HorseOut) {
+        // Not from under Player 2.
+        if (have && procCreated(s_p2HorseId) && (p2 == nullptr || !p2->checkRide())) {
+            fpcM_Delete(fpcM_SearchByID(s_p2HorseId));
+            s_p2HorseId = kNoProc;
+        }
+        return;
+    }
+    if (have) {
+        return;
+    }
+    // On the side Player 2 joins on when Player 1 rides (spawnPosition), a
+    // little further out, so they can get straight on.
+    const s16 side = p1Horse->shape_angle.y + 0x4000;
+    cXyz pos(p1Horse->current.pos.x + cM_ssin(side) * 420.0f, p1Horse->current.pos.y + 50.0f,
+             p1Horse->current.pos.z + cM_scos(side) * 420.0f);
+    dBgS_GndChk gnd;
+    gnd.SetPos(&pos);
+    const f32 y = dComIfG_Bgsp().GroundCross(&gnd);
+    if (y == -G_CM3D_F_INF || std::fabs(y - p1Horse->current.pos.y) > 80.0f) {
+        return;  // no level ground there now; tried again next frame
+    }
+    pos.y = y;
+    const csXyz angle(0, p1Horse->shape_angle.y, 0);
+    ScopedCtx ctx(1, 1);
+    s_p2HorseId = fopAcM_create(fpcNm_HORSE_e, fopAcM_GetParam(p1Horse), &pos, fopAcM_GetRoomNo(p1Horse),
+                                &angle, NULL, -1);
+    DuskLog.info("splitscreen: Player 2's horse ({})", s_p2HorseId);
+}
+
+// Link takes his form (Hylian or wolf) from the save as he is created, so a
+// Player 2 created next to Player 1 matches them.
+bool formsDiffer(fopAc_ac_c* p1, fopAc_ac_c* p2) {
+    return static_cast<daPy_py_c*>(p1)->checkWolf() != static_cast<daPy_py_c*>(p2)->checkWolf();
+}
