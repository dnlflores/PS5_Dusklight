+}
+
+void onScenePlayExecute() {
+    if (!s_sceneActive) {
+        return;
+    }
+
+    if (++s_pruneTimer >= kPruneInterval) {
+        s_pruneTimer = 0;
+        prune();
+    }
+    s_p2CameraReady = procCreated(s_p2CameraId);
+
+    fopAc_ac_c* p1 = play().getPlayerPhysical(0);
+    const bool want = enabled() && p1 != nullptr && !fpcM_IsCreating(fopAcM_GetID(p1));
+    const bool linkAlive = procAlive(s_p2LinkId);
+    const bool cameraAlive = procAlive(s_p2CameraId);
+
+    if (!want) {
+        if (linkAlive || cameraAlive) {
+            if (!fpcM_IsCreating(s_p2LinkId) && !fpcM_IsCreating(s_p2CameraId)) {
+                despawn();
+            }
+        }
+        setLead(0, "split-screen off");
+        return;
+    }
+
+    markPlayer1(p1);
+    const bool busy = worldBusy();
+
+    if (!s_pendingDelete.empty()) {
+        if (++s_pendingDeleteFrames < kPendingDeleteGiveUpFrames) {
+            return;
+        }
+        DuskLog.warn("splitscreen: {} of Player 2's processes were not deleted after {} frames",
+                     s_pendingDelete.size(), s_pendingDeleteFrames);
+        s_pendingDelete.clear();
+    }
+
+    if (!linkAlive) {
+        // Gone (or never there): start again once Player 1 is free.
+        setLead(0, "Player 2 gone");
+        if (cameraAlive && procCreated(s_p2CameraId)) {
+            fpcM_Delete(fpcM_SearchByID(s_p2CameraId));
+            s_p2CameraId = kNoProc;
+            s_p2CameraReady = false;
+        }
+        s_suspended = false;
+        if (s_cooldown > 0) {
+            s_cooldown--;
+            return;
+        }
+        if (!busy && !cameraAlive) {
+            spawn(p1);
+        }
+        return;
+    }
+
+    s_suspended = busy;
+    fopAc_ac_c* p2 = player2();
+    if (s_suspended || p2 == nullptr || fpcM_IsCreating(s_p2LinkId)) {
+        s_separatedFrames = 0;
+        return;
+    }
+
+    // Pausing is the lead's (the menus read the lead's controller), so the
+    // other player pressing Start takes the lead first.
+    const uint8_t other = s_lead ^ 1;
+    if (mDoCPd_c::m_cpadInfo[other == 0 ? PAD_1 : PAD_2].mPressedButtonFlags & PAD_BUTTON_START) {
+        setLead(other, "pause");
+    }
+
+    // The follower is brought back to the lead: Player 2 is created again next
+    // to Player 1; Player 1 is moved to Player 2.
+    fopAc_ac_c* lead = s_lead == 0 ? p1 : p2;
+    fopAc_ac_c* follower = s_lead == 0 ? p2 : p1;
+    const f32 dist = (follower->current.pos - lead->current.pos).abs();
+    const bool riding =
+        static_cast<daPy_py_c*>(p1)->checkRide() || static_cast<daPy_py_c*>(p2)->checkRide();
+    const f32 leash = riding ? kRidingLeashDistance : kLeashDistance;
+    const f32 hardLeash = riding ? kRidingHardLeashDistance : kHardLeashDistance;
+    const bool apart = dist > leash || fopAcM_GetRoomNo(follower) != fopAcM_GetRoomNo(lead);
+    s_separatedFrames = apart ? s_separatedFrames + 1 : 0;
+    const bool separated = dist > hardLeash || s_separatedFrames > kSeparatedFramesLimit;
+    // Player 2 takes Player 1's form (only Player 1 transforms).
+    const bool changeForm = formsDiffer(p1, p2);
+    if (changeForm || (s_lead == 0 && (s_respawnRequested || separated))) {
+        DuskLog.info("splitscreen: bringing Player 2 back to Player 1 (distance {:.0f}, requested {}, form {})",
+                     dist, s_respawnRequested, changeForm);
+        despawn();
+        s_cooldown = 2;
+        return;
+    }
+    if (s_lead == 1 && (s_bringPlayer1Requested || separated)) {
+        DuskLog.info("splitscreen: bringing Player 1 to Player 2 (distance {:.0f}, requested {})", dist,
+                     s_bringPlayer1Requested);
+        bringPlayer1ToLead(p1, p2);
+        s_bringPlayer1Requested = false;
+        s_separatedFrames = 0;
+    }
+    s_respawnRequested = false;
+    s_bringPlayer1Requested = false;
+
+    updatePlayer2Horse();
+
+    if (s_p2Attention != nullptr && procCreated(s_p2CameraId)) {
+        ScopedCtx ctx(1, 1);
+        s_p2Attention->Run();
+    }
+}
+
+void onScenePlayDraw() {
+    if (!s_sceneActive || s_suspended || s_p2Attention == nullptr || !procCreated(s_p2CameraId) ||
+        player2() == nullptr)
+    {
+        return;
+    }
+    ScopedCtx ctx(1, g_ctx.camera);
+    s_p2Attention->Draw();
+}
+
+dAttention_c* player2Attention() {
+    return s_p2Attention;
+}
+
+void redrawSceneForWindow() {
+    dDlst_list_c& dl = g_dComIfG_gameInfo.drawlist;
+    const dDlst_list_c::Cursors2D cursors = dl.save2DCursors();
+    dl.reset3D();
+
+    auto* cam = reinterpret_cast<camera_process_class*>(dComIfGp_getCamera(0));
+    if (cam != nullptr) {
+        j3dSys.setViewMtx(cam->view.viewMtx);
+    }
+
+    s_extraPass = true;
+    fpcM_DrawIterater((fpcM_DrawIteraterFunc)fpcM_Draw);
+    dComIfGp_drawSimpleModel();
+    s_extraPass = false;
+
+    dl.restore2DCursors(cursors);
+}
+
+bool inExtraViewPass() {
+    return s_extraPass;
+}
+
+bool isPlayScene(const base_process_class* proc) {
+    return proc != nullptr && proc->name == fpcNm_PLAY_SCENE_e;
+}
+
+bool drawsInExtraView(const base_process_class* proc) {
+    if (!s_extraPass || s_inDraw) {
+        return true;
+    }
+    return proc != nullptr && (proc->name == fpcNm_PLAY_SCENE_e || proc->name == fpcNm_KANKYO_e);
+}
+
+void drawExtraViewSceneExtras() {
+    if (dComIfGp_isPauseFlag()) {
+        return;
+    }
+    {
+        ScopedCtx p1(0, g_ctx.camera);
+        play().mAttention.Draw();
+    }
+    onScenePlayDraw();
+}
+
+bool isPassCamera(const camera_class* camera) {
+    const camera_class* pass = play().getCameraPhysical(passCamera());
+    return pass == nullptr || pass == camera;
+}
+
+void beginPass(int window) {
+    s_passCamera = static_cast<uint8_t>(window);
+    s_inPass = true;
+    switchTo(topCtx());
+}
+
+void endPass() {
+    s_passCamera = 0;
+    s_inPass = false;
+    switchTo(topCtx());
+}
+
+bool isAudioCamera(const camera_class* camera) {
+    const camera_class* leadCam = play().getCameraPhysical(s_lead);
+    return leadCam == nullptr || leadCam == camera;
+}
+
+// Whoever is not the lead does not change the scene or the room: Player 2 is
+// created again next to Player 1, Player 1 is moved to Player 2.
+bool blockSceneChange() {
+    if (g_ctx.player != s_lead) {
+        (g_ctx.player == 1 ? s_respawnRequested : s_bringPlayer1Requested) = true;
+        return true;
+    }
+    return false;
+}
+
+bool blockGlobalChange() {
+    return g_ctx.player != s_lead;
+}
+
+bool blockEventOrder(u16 type) {
+    if (g_ctx.player == s_lead || s_curOwner < 0) {
+        return false;
+    }
+    // A player's own interaction (talking, a door, a chest, an item) makes
+    // them the lead; anything else they would start (a fall, a cutscene) is
+    // left to the lead.
+    switch (type) {
+    case dEvt_type_TALK_e:
+    case dEvt_type_DOOR_e:
+    case dEvt_type_ITEM_e:
+    case dEvt_type_SHOWITEM_X_e:
+    case dEvt_type_SHOWITEM_Y_e:
+    case dEvt_type_CATCH_e:
+    case dEvt_type_TREASURE_e:
+        if (!dComIfGp_event_runCheck()) {
+            setLead(g_ctx.player, "interaction");
+            return false;
+        }
+        return true;
+    default:
+        return true;
+    }
+}
+
+bool dropsDamage() {
+    return s_curOwner == 1;
+}
+
+int lead() {
+    return s_lead;
+}
+
+bool noFriendlyFire(fopAc_ac_c* at, fopAc_ac_c* tg) {
+    if (at == nullptr || tg == nullptr || s_owned.empty()) {
+        return false;
+    }
+    const auto onTeam = [](fopAc_ac_c* ac) {
+        return fopAcM_GetName(ac) == fpcNm_ALINK_e || s_owned.count(fopAcM_GetID(ac)) != 0 ||
+               s_ownedP1.count(fopAcM_GetID(ac)) != 0;
+    };
+    return onTeam(at) && onTeam(tg);
+}
+
+}  // namespace dusk::splitscreen
diff --git a/src/dusk/splitscreen.h b/src/dusk/splitscreen.h
new file mode 100644
index 0000000..da3965b
--- /dev/null
+++ b/src/dusk/splitscreen.h
@@ -0,0 +1,152 @@
+#pragma once
+
+// Split-screen co-op: a second Link on controller 2, with its own camera and
+// its own half of the screen.
+//
+// Player 2 is a companion. The story, events, doors, enemies' targeting and
+// room loading still follow Player 1; Player 2 runs, fights and climbs beside
+// them, hides while a cutscene plays, and is brought back next to Player 1
+// whenever it would leave the area Player 1 is in.
+//
+// How the second player fits into a one-player engine is described in
+// splitscreen_ctx.h (the player context) and docs/splitscreen.md.
+
+#include "dusk/splitscreen_ctx.h"
+#include "global.h"
+
+struct base_process_class;
+class camera_class;
+class fopAc_ac_c;
+class dAttention_c;
+typedef unsigned int fpc_ProcID;
+
+namespace dusk::splitscreen {
+
+// The setting is on.
+bool enabled();
+
+// Both halves of the screen are being drawn this frame.
+bool active();
+
+// How many views the painter draws: 2 while active, else 1.
+int windowCount();
+
+// What the cameras multiply their aspect ratio by while split.
+float aspectScale();
+
+// Player 2's Link actor, or nullptr.
+fopAc_ac_c* player2();
+
+bool isPlayer2(const fopAc_ac_c* actor);
+
+// Either player's Link, while split-screen is on.
+bool isPlayerLink(const fopAc_ac_c* actor);
+
+// A second Link has been in this scene, so the Links' shared model data has to
+// be rebound to each Link before it animates or draws (daAlink_c).
+bool linksShareModelData();
+
+// --- Process ownership -----------------------------------------------------
+// Every process created while Player 2's context is active belongs to Player 2
+// and runs in that context: its Link, its camera, and what its Link spawns.
+
+void onProcIdMade(fpc_ProcID id);
+void onProcDeleted(fpc_ProcID id);
+bool isSecondaryProc(const base_process_class* proc);
+bool isSuspendedProc(const base_process_class* proc);
+
+// Returns the previous value. While a process draws, the processes it draws
+// in turn (a scene's actors) are nested inside it.
+bool setInDraw(bool inDraw);
+
+// Whether a process draws in the second view: everything a scene draws, and of
+// the top-level processes only the play scene and the environment (lights,
+// sun) are drawn again.
+bool drawsInExtraView(const base_process_class* proc);
+
+// Puts a process's context in place for one of its methods.
+class ProcessScope {
+public:
+    explicit ProcessScope(const base_process_class* proc);
+    ~ProcessScope();
+    ProcessScope(const ProcessScope&) = delete;
+    ProcessScope& operator=(const ProcessScope&) = delete;
+
+private:
+    Ctx mSaved;
+    int mSavedOwner;
+    bool mChanged;
+};
+
+// Puts an explicit context in place; what is created meanwhile belongs to
+// that player.
+class ScopedCtx {
+public:
+    ScopedCtx(uint8_t player, uint8_t camera);
+    ~ScopedCtx();
+    ScopedCtx(const ScopedCtx&) = delete;
+    ScopedCtx& operator=(const ScopedCtx&) = delete;
+
+private:
+    Ctx mSaved;
+    int mSavedOwner;
+    bool mChanged;
+};
+
+// --- Scene hooks (d_s_play.cpp) ------------------------------------------
+
+void onScenePlayCreate();
+void onScenePlayExecute();
+void onScenePlayDraw();
+void onScenePlayDelete();
+
+// Player 2's lock-on/attention system, or nullptr.
+dAttention_c* player2Attention();
+
+// --- Rendering (m_Do_graphic.cpp, d_camera.cpp) --------------------------
+
+// The painter draws window 0, then window 1, each between these. The camera
+// bit follows the window, so "camera 0" and the current view are that
+// window's camera.
+void beginPass(int window);
+void endPass();
+
+// Draws the scene again into the draw lists for Player 2's camera. Call
+// between beginPass(1) and endPass().
+void redrawSceneForWindow();
+
+// True during that second draw: actors are drawn, not advanced.
+bool inExtraViewPass();
+
+// In the second draw, only the play scene draws its actors (and none of its
+// own per-frame work); it also draws both players' lock-on markers.
+bool isPlayScene(const base_process_class* proc);
+void drawExtraViewSceneExtras();
+
+// Whether this camera's draw sets the view used by the current pass.
+bool isPassCamera(const camera_class* camera);
+
+// Whether this camera feeds the sound system (the lead's does).
+bool isAudioCamera(const camera_class* camera);
+
+// --- Guards ----------------------------------------------------------------
+// Called where the game would change something only the lead (the player the
+// world follows) may change. Return true (and do nothing) when the other
+// player's context is active.
+
+bool blockSceneChange();
+bool blockGlobalChange();
+// An event the other player orders: their own interactions (talking, doors,
+// chests, items) make them the lead and go ahead; anything else is blocked.
+bool blockEventOrder(u16 type);
+
+// Whether damage taken now is Player 2's, which the shared hearts ignore.
+bool dropsDamage();
+
+// The player the world follows (0 or 1).
+int lead();
+
+// Friendly fire between the two Links (and what Player 2 throws or shoots).
+bool noFriendlyFire(fopAc_ac_c* at, fopAc_ac_c* tg);
+
+}  // namespace dusk::splitscreen
diff --git a/src/dusk/splitscreen_colors.cpp b/src/dusk/splitscreen_colors.cpp
new file mode 100644
index 0000000..fbd1d80
--- /dev/null
+++ b/src/dusk/splitscreen_colors.cpp
@@ -0,0 +1,402 @@
+// Split-screen: each player's own colours for their Link. See splitscreen_colors.h.
+
+#include "dusk/splitscreen_colors.h"
+
+#include "JSystem/J3DGraphAnimator/J3DModel.h"
+#include "JSystem/J3DGraphAnimator/J3DModelData.h"
+#include "JSystem/J3DGraphBase/J3DTexture.h"
+#include "d/actor/d_a_alink.h"
+#include "dusk/settings.h"
+#include "dusk/splitscreen.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace dusk::splitscreen::colors {
+namespace {
+
+// What a texture holds, by its name in Link's models.
+enum class Part { None, Tunic, Skin, Wolf };
+
+Part partOf(const char* name) {
+    if (name == nullptr) {
+        return Part::None;
+    }
+    // The Hero's clothes, and the Ordon clothes' green vest (only their green
+    // is changed, so the shirt and trims stay).
+    static const char* const kTunic[] = {
+        "al_upbody", "al_lowbody", "al_cap", "al_skirt", "bl_upbody", "bl_lowbody",
+    };
+    static const char* const kSkin[] = {
+        "al_face", "al_ear", "al_hand", "bl_skin", "bl_hand", "bl_handL",
+    };
+    for (const char* tunic : kTunic) {
+        if (std::strcmp(name, tunic) == 0) {
+            return Part::Tunic;
+        }
+    }
+    for (const char* skin : kSkin) {
+        if (std::strcmp(name, skin) == 0) {
+            return Part::Skin;
+        }
+    }
+    return std::strcmp(name, "wl_body") == 0 ? Part::Wolf : Part::None;
+}
+
+struct Rgb {
+    float r, g, b;
+};
+
+std::optional<Rgb> parseColor(const std::string& value) {
+    std::string_view hex = value;
+    if (!hex.empty() && hex.front() == '#') {
+        hex.remove_prefix(1);
+    }
+    if (hex.size() != 6) {
+        return std::nullopt;
+    }
+    unsigned channels[3];
+    for (int i = 0; i < 3; i++) {
+        unsigned v = 0;
+        for (int j = 0; j < 2; j++) {
+            const char c = hex[i * 2 + j];
+            v <<= 4;
+            if (c >= '0' && c <= '9') {
+                v |= c - '0';
+            } else if (c >= 'a' && c <= 'f') {
+                v |= c - 'a' + 10;
+            } else if (c >= 'A' && c <= 'F') {
+                v |= c - 'A' + 10;
+            } else {
+                return std::nullopt;
+            }
+        }
+        channels[i] = v;
+    }
+    return Rgb{static_cast<float>(channels[0]), static_cast<float>(channels[1]),
+               static_cast<float>(channels[2])};
+}
+
+// A player's colours; an empty one leaves that part as the game has it.
+struct Palette {
+    std::optional<Rgb> tunic, skin, wolf;
+    std::string key;
+
+    const std::optional<Rgb>& of(Part part) const {
+        static const std::optional<Rgb> kNone;
+        switch (part) {
+        case Part::Tunic:
+            return tunic;
+        case Part::Skin:
+            return skin;
+        case Part::Wolf:
+            return wolf;
+        default:
+            return kNone;
+        }
+    }
+};
+
+Palette paletteFor(int player) {
+    auto& game = getSettings().game;
+    Palette palette;
+    if (!game.splitScreen.getValue()) {
+        return palette;
+    }
+    const std::string tunic = (player == 0 ? game.splitScreenP1Tunic : game.splitScreenP2Tunic).getValue();
+    const std::string skin = (player == 0 ? game.splitScreenP1Skin : game.splitScreenP2Skin).getValue();
+    const std::string wolf = (player == 0 ? game.splitScreenP1Wolf : game.splitScreenP2Wolf).getValue();
+    palette.tunic = parseColor(tunic);
+    palette.skin = parseColor(skin);
+    palette.wolf = parseColor(wolf);
+    palette.key = tunic + "/" + skin + "/" + wolf;
+    return palette;
+}
+
+// --- Recolouring -------------------------------------------------------------
+// Each part's pixels are picked out by hue, saturation and brightness, and
+// mapped to the chosen colour with their shading kept: a pixel of the part's
+// average brightness becomes the chosen colour (scaled down by what the game's
+// lighting adds), darker and lighter ones follow. The averages were measured
+// on the game's own textures with the same selection.
+
+constexpr float kTunicReference = 48.9f;
+constexpr float kSkinReference = 113.3f;
+constexpr float kWolfReference = 63.0f;
+constexpr float kLightingGain = 0.62f;
+
+float smoothstep(float e0, float e1, float x) {
+    const float t = std::clamp((x - e0) / (e1 - e0), 0.0f, 1.0f);
+    return t * t * (3.0f - 2.0f * t);
+}
+
+// 1 inside [lo, hi] degrees, falling to 0 over `soft` degrees either side.
+float hueBand(float hue, float lo, float hi, float soft) {
+    return std::min(smoothstep(lo - soft, lo, hue), 1.0f - smoothstep(hi, hi + soft, hue));
+}
+
+void toHsv(const Rgb& c, float& h, float& s, float& v) {
+    const float r = c.r / 255.0f, g = c.g / 255.0f, b = c.b / 255.0f;
+    const float mx = std::max({r, g, b}), mn = std::min({r, g, b});
+    const float d = mx - mn;
+    v = mx;
+    s = mx > 0.0f ? d / mx : 0.0f;
+    if (d <= 0.0f) {
+        h = 0.0f;
+    } else if (mx == r) {
+        h = 60.0f * std::fmod((g - b) / d + 6.0f, 6.0f);
+    } else if (mx == g) {
+        h = 60.0f * ((b - r) / d + 2.0f);
+    } else {
+        h = 60.0f * ((r - g) / d + 4.0f);
+    }
+}
+
+float partWeight(Part part, const Rgb& c) {
+    float h, s, v;
+    toHsv(c, h, s, v);
+    switch (part) {
+    case Part::Tunic:  // green
+        return hueBand(h, 65.0f, 170.0f, 12.0f) * smoothstep(0.08f, 0.16f, s) * smoothstep(0.03f, 0.08f, v);
+    case Part::Skin:  // warm, neither grey nor vivid, not dark (leather, hair edges)
+        return hueBand(h, 0.0f, 38.0f, 8.0f) * smoothstep(0.08f, 0.15f, s) * (1.0f - smoothstep(0.62f, 0.75f, s)) *
+               smoothstep(0.30f, 0.42f, v);
+    case Part::Wolf:  // the fur; not the green markings, not vivid colours
+        return (1.0f - smoothstep(0.55f, 0.70f, s)) *
+               (1.0f - hueBand(h, 65.0f, 185.0f, 15.0f) * smoothstep(0.15f, 0.25f, s));
+    default:
+        return 0.0f;
+    }
+}
+
+float partReference(Part part) {
+    switch (part) {
+    case Part::Tunic:
+        return kTunicReference;
+    case Part::Skin:
+        return kSkinReference;
+    default:
+        return kWolfReference;
+    }
+}
+
+Rgb recolor(Part part, const Rgb& c, const Rgb& target) {
+    const float w = partWeight(part, c);
+    if (w <= 0.0f) {
+        return c;
+    }
+    const float luma = 0.299f * c.r + 0.587f * c.g + 0.114f * c.b;
+    const float k = kLightingGain * luma / partReference(part);
+    const Rgb mapped{std::min(255.0f, target.r * k), std::min(255.0f, target.g * k), std::min(255.0f, target.b * k)};
+    return Rgb{c.r + (mapped.r - c.r) * w, c.g + (mapped.g - c.g) * w, c.b + (mapped.b - c.b) * w};
+}
+
+Rgb from565(u16 v) {
+    const unsigned r = (v >> 11) & 31, g = (v >> 5) & 63, b = v & 31;
+    return Rgb{static_cast<float>((r << 3) | (r >> 2)), static_cast<float>((g << 2) | (g >> 4)),
+               static_cast<float>((b << 3) | (b >> 2))};
+}
+
+u16 to565(const Rgb& c) {
+    const auto q = [](float x, int bits) {
+        const int max = (1 << bits) - 1;
+        return std::clamp(static_cast<int>(std::lround(x / 255.0f * max)), 0, max);
+    };
+    return static_cast<u16>((q(c.r, 5) << 11) | (q(c.g, 6) << 5) | q(c.b, 5));
+}
+
+// GX CMPR: 8-byte blocks of two big-endian RGB565 end colours and sixteen
+// 2-bit indices. Only the end colours change; a block keeps its mode (four
+// colours when the first is greater, else three and transparent), swapping
+// its end colours and their indices when the new colours compare the other way.
+void recolorCmpr(u8* data, size_t size, Part part, const Rgb& target) {
+    for (size_t off = 0; off + 8 <= size; off += 8) {
+        u8* block = data + off;
+        const u16 c0 = static_cast<u16>((block[0] << 8) | block[1]);
+        const u16 c1 = static_cast<u16>((block[2] << 8) | block[3]);
+        u16 n0 = to565(recolor(part, from565(c0), target));
+        u16 n1 = to565(recolor(part, from565(c1), target));
+        if (n0 == c0 && n1 == c1) {
+            continue;
+        }
+        if (c0 > c1) {
+            if (n0 == n1) {
+                if (n1 > 0) {
+                    n1--;
+                } else {
+                    n0++;
+                }
+            }
+            if (n0 < n1) {
+                std::swap(n0, n1);
+                for (int i = 4; i < 8; i++) {
+                    block[i] ^= 0x55;  // 0<->1, 2<->3
+                }
+            }
+        } else if (n0 > n1) {
+            std::swap(n0, n1);
+            for (int i = 4; i < 8; i++) {
+                u8 swapped = 0;
+                for (int p = 0; p < 4; p++) {
+                    u8 idx = (block[i] >> (6 - 2 * p)) & 3;
+                    if (idx < 2) {
+                        idx ^= 1;  // the end colours swap; the midpoint and transparent stay
+                    }
+                    swapped |= idx << (6 - 2 * p);
+                }
+                block[i] = swapped;
+            }
+        }
+        block[0] = static_cast<u8>(n0 >> 8);
+        block[1] = static_cast<u8>(n0);
+        block[2] = static_cast<u8>(n1 >> 8);
+        block[3] = static_cast<u8>(n1);
+    }
+}
+
+size_t cmprSize(const ResTIMG& img) {
+    return GXGetTexBufferSize(img.width, img.height, GX_TF_CMPR, img.mipmapEnabled ? GX_TRUE : GX_FALSE,
+                              img.mipmapCount);
+}
+
+// --- Texture tables ------------------------------------------------------------
+
+struct Table {
+    J3DModelData* modelData = nullptr;
+    J3DTexture* original = nullptr;
+    ResTIMG* firstRes = nullptr;
+    u16 num = 0;
+    std::string key;
+    std::unique_ptr<J3DTexture> texture;  // nullptr: nothing in this model changes
+    std::vector<std::unique_ptr<u8[]>> images;
+};
+
+struct Retired {
+    std::unique_ptr<J3DTexture> texture;
+    std::vector<std::unique_ptr<u8[]>> images;
+    int frame;
+};
+
+std::vector<Table> s_tables[2];
+std::vector<Retired> s_retired;
+int s_frame = 0;
+
+// A table's texture objects may still be referenced by commands already queued
+// for the GPU, so a table that is replaced is kept a few frames.
+void retire(Table& table) {
+    if (table.texture != nullptr) {
+        s_retired.push_back(Retired{std::move(table.texture), std::move(table.images), s_frame});
+    }
+    table.images.clear();
+}
+
+void buildTable(Table& table, J3DModelData* modelData, const Palette& palette) {
+    retire(table);
+    J3DTexture* original = modelData->getTexture();
+    table.modelData = modelData;
+    table.original = original;
+    table.num = original->getNum();
+    table.firstRes = original->getResTIMG(0);
+    table.key = palette.key;
+
+    JUTNameTab* names = modelData->getTextureName();
+    std::unique_ptr<J3DTexture> copy;
+    for (u16 i = 0; i < table.num; i++) {
+        const Part part = partOf(names != nullptr ? names->getName(i) : nullptr);
+        const auto& target = palette.of(part);
+        ResTIMG* img = original->getResTIMG(i);
+        if (part == Part::None || !target.has_value() || static_cast<int>(img->format) != GX_TF_CMPR) {
+            continue;
+        }
+        if (copy == nullptr) {
+            copy = std::make_unique<J3DTexture>(table.num, table.firstRes);
+            copy->copyDataPtrs(*original);
+        }
+        const size_t size = cmprSize(*img);
+        auto image = std::make_unique<u8[]>(size);
+        std::memcpy(image.get(), original->getImgDataPtr(i), size);
+        recolorCmpr(image.get(), size, part, *target);
+        copy->setImgDataPtr(i, image.get());
+        table.images.push_back(std::move(image));
+    }
+    table.texture = std::move(copy);
+}
+
+J3DTexture* textureFor(int player, J3DModelData* modelData, const Palette& palette) {
+    J3DTexture* original = modelData->getTexture();
+    if (original == nullptr || original->getNum() == 0) {
+        return original;
+    }
+    auto& tables = s_tables[player];
+    Table* table = nullptr;
+    for (auto& t : tables) {
+        if (t.modelData == modelData) {
+            table = &t;
+            break;
+        }
+    }
+    if (table == nullptr) {
+        table = &tables.emplace_back();
+    }
+    // Rebuilt when the colours change, or when this address now holds other
+    // model data (Link's clothes and wolf models are loaded and freed).
+    if (table->key != palette.key || table->original != original || table->num != original->getNum() ||
+        table->firstRes != original->getResTIMG(0))
+    {
+        buildTable(*table, modelData, palette);
+    }
+    return table->texture != nullptr ? table->texture.get() : original;
+}
+
+void applyToModel(int player, J3DModel* model, const Palette& palette) {
+    if (model == nullptr) {
+        return;
+    }
+    J3DModelData* modelData = model->getModelData();
+    J3DTexture* texture = palette.key.empty() ? modelData->getTexture() : textureFor(player, modelData, palette);
+    for (u16 i = 0; i < modelData->getMaterialNum(); i++) {
+        model->getMatPacket(i)->setTexture(texture);
+    }
+}
+
+void freeRetired(bool all) {
+    std::erase_if(s_retired, [all](const Retired& r) { return all || s_frame - r.frame > 16; });
+}
+
+}  // namespace
+
+void apply(daAlink_c* link, int player) {
+    if (player < 0 || player > 1) {
+        return;
+    }
+    s_frame++;
+    freeRetired(false);
+    const Palette palette = paletteFor(player);
+    if (palette.key.empty() && s_tables[player].empty()) {
+        return;  // never recoloured: the models still point at their own tables
+    }
+    applyToModel(player, link->mpLinkModel, palette);
+    applyToModel(player, link->mpLinkFaceModel, palette);
+    applyToModel(player, link->mpLinkHatModel, palette);
+    applyToModel(player, link->mpLinkHandModel, palette);
+    applyToModel(player, link->mpLinkBootModels[0], palette);
+    applyToModel(player, link->mpLinkBootModels[1], palette);
+}
+
+void onSceneDelete() {
+    for (auto& tables : s_tables) {
+        for (auto& table : tables) {
+            retire(table);
+        }
+        tables.clear();
+    }
+    // The scene's draws are done by the time it is deleted.
+    freeRetired(true);
+}
+
+}  // namespace dusk::splitscreen::colors
diff --git a/src/dusk/splitscreen_colors.h b/src/dusk/splitscreen_colors.h
new file mode 100644
index 0000000..2aa8926
--- /dev/null
+++ b/src/dusk/splitscreen_colors.h
@@ -0,0 +1,23 @@
+#pragma once
+
+// Split-screen: each player's own colours for their Link (tunic, skin, wolf
+// fur), so the two Links can be told apart.
+//
+// Link's colours are in his textures (S3TC-compressed, GX CMPR), and on PC a
+// material loads its textures at draw time from its packet's own texture
+// table (J3DMatPacket::mpTexture). So each player's Link gets its own copy of
+// the table, with recoloured copies of the textures that hold the tunic, the
+// skin or the fur; the model data, and everything else, stays shared.
+
+class daAlink_c;
+
+namespace dusk::splitscreen::colors {
+
+// Points this Link's models at its player's texture tables. Called before the
+// Link enters its models into the draw lists (daAlink_c::draw).
+void apply(daAlink_c* link, int player);
+
+// Frees what the old scene's tables hold.
+void onSceneDelete();
+
+}  // namespace dusk::splitscreen::colors
diff --git a/src/dusk/splitscreen_ctx.h b/src/dusk/splitscreen_ctx.h
new file mode 100644
index 0000000..2eaccf4
--- /dev/null
+++ b/src/dusk/splitscreen_ctx.h
@@ -0,0 +1,51 @@
+#pragma once
+
+// Split-screen co-op: the "player context".
+//
+// The game was written for one player. Rather than touching the thousands of
+// places that ask for "the player" (dComIfGp_getPlayer(0)) or "the camera"
+// (dComIfGp_getCamera(0)), the engine's per-player tables keep a second slot,
+// and these two bits decide which slot index 0 means right now:
+//
+//   player  1 while Player 2's own processes (its Link actor, the things that
+//           actor spawns) run. Index 0 of the player tables and pad 0 then
+//           mean Player 2.
+//   camera  1 while Player 2's camera runs, or while the frame for Player 2's
+//           half of the screen is being drawn. Index 0 of the camera tables
+//           and the current view then mean Player 2's camera.
+//
+// Indices 0 and 1 swap; anything else passes through. Stored values that are
+// themselves indices (a camera's player, a player's camera) are kept physical
+// and go through the same swap when read.
+//
+// This header is included by d_com_inf_game.h and m_Do_controller_pad.h, so it
+// stays free of dependencies.
+
+#include <stdint.h>
+
+namespace dusk::splitscreen {
+
+struct Ctx {
+    uint8_t player;
+    uint8_t camera;
+};
+
+extern Ctx g_ctx;
+
+inline int remapPlayer(int i) {
+    return (i == 0 || i == 1) ? (i ^ g_ctx.player) : i;
+}
+
+inline int remapCamera(int i) {
+    return (i == 0 || i == 1) ? (i ^ g_ctx.camera) : i;
+}
+
+inline uint32_t remapPad(uint32_t pad) {
+    return (pad <= 1) ? (pad ^ g_ctx.player) : pad;
+}
+
+inline bool inSecondaryPlayer() {
+    return g_ctx.player != 0;
+}
+
+}  // namespace dusk::splitscreen
