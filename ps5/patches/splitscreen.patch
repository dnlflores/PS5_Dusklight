+    s_bringPlayer1Requested = false;
+    s_owned.clear();
+    s_ownedP1.clear();
+    s_pendingDelete.clear();
+    s_p2LinkId = kNoProc;
+    s_p2CameraId = kNoProc;
+    s_p2HorseId = kNoProc;
+    s_suspended = false;
+    s_respawnRequested = false;
+    s_cooldown = 30;
+    s_separatedFrames = 0;
+    s_p2Attention = nullptr;
+    s_p2AttentionMem = nullptr;
